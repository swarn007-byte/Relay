# Relay configuration — copy to .env and adjust. Never commit real secrets.

RELAY_PORT=8081
RELAY_DB_PATH=data/relay.db

RELAY_WORKER_COUNT=4
RELAY_SCHEDULER_INTERVAL=1s
RELAY_SCHEDULER_BATCH_SIZE=20
RELAY_HTTP_TIMEOUT=10s

RELAY_MAX_ATTEMPTS=5
RELAY_RETRY_BASE_DELAY=5s
RELAY_RETRY_MAX_DELAY=60s
RELAY_LEASE_TTL=60s
RELAY_SHUTDOWN_TIMEOUT=15s

# Required, at least 32 bytes. Generate with: openssl rand -hex 32
RELAY_WEBHOOK_SECRET=

# Management API bearer token, at least 16 characters.
# If unset, /deliveries endpoints are disabled.
RELAY_ADMIN_TOKEN=

# Development only: allow loopback/private destinations (httptest, local receivers).
# Never enable in production.
RELAY_ALLOW_PRIVATE_DESTINATIONS=false

# Allowed destination ports (ignored when private destinations are allowed).
RELAY_ALLOWED_PORTS=80,443

RELAY_MAX_BODY_BYTES=1048576

# Defaults to SaaS mode. Set true ONLY for the original private single-owner API.
RELAY_LEGACY_MODE=false
